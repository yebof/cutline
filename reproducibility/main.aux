\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Threats, mechanisms and status. ``Certified'': covered by a theorem under the stated assumptions; ``bounded'': limited by a level rule, not by a theorem; ``printed'': shown to the buyer or platform, no guarantee. \mbox  {\sffamily  \upshape RF0}--\mbox  {\sffamily  \upshape RF5}: residual freedom of Theorem\nobreakspace  {}\ref  {thm:e2e}; tested blocks: all blocks of the certified MCUs $M_{\mathrm  {cert}}$, which contain the drawn outline $\mathit  {Sil}$; E13, E14: additional experiments of Sec.\nobreakspace  {}\ref  {sec:eval-e5}; $\Delta E_{00}$: CIEDE2000 colour difference.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:threats}{{I}{4}{Threats, mechanisms and status. ``Certified'': covered by a theorem under the stated assumptions; ``bounded'': limited by a level rule, not by a theorem; ``printed'': shown to the buyer or platform, no guarantee. \RF {0}--\RF {5}: residual freedom of Theorem~\ref {thm:e2e}; tested blocks: all blocks of the certified MCUs $\Mcert $, which contain the drawn outline $\Sil $; E13, E14: additional experiments of Sec.~\ref {sec:eval-e5}; $\Delta E_{00}$: CIEDE2000 colour difference}{table.1}{}}
