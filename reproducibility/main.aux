\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {\textsc  {Cutline}{} end to end.} (1)\nobreakspace  {}The attested capture app fixes the product region, commits salted cells of it and anchors the record after a fresh beacon. (2)\nobreakspace  {}The back office compiles the listing from the opened cells and a public (here generated) background and encodes it with libjpeg \texttt  {islow}{}. (3)\nobreakspace  {}Platforms register the claim and link re-encoded renditions by verified hops. (4)\nobreakspace  {}Any verifier checks every certified block against the rebuilt reference. (5)\nobreakspace  {}The buyer sees the certified outline and a level \mbox  {\sffamily  \upshape G0}--\mbox  {\sffamily  \upshape G4}. The ledger (one validator per regulatory bloc) holds anchors, beacon, registries, the court and the status that caps the level; masters, unopened cells and salts stay with the seller.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:arch}{{1}{2}{\textbf {\sys {} end to end.} (1)~The attested capture app fixes the product region, commits salted cells of it and anchors the record after a fresh beacon. (2)~The back office compiles the listing from the opened cells and a public (here generated) background and encodes it with libjpeg \islow {}. (3)~Platforms register the claim and link re-encoded renditions by verified hops. (4)~Any verifier checks every certified block against the rebuilt reference. (5)~The buyer sees the certified outline and a level \G {0}--\G {4}. The ledger (one validator per regulatory bloc) holds anchors, beacon, registries, the court and the status that caps the level; masters, unopened cells and salts stay with the seller}{figure.1}{}}
