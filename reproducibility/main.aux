\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {A codec-cell opening on a real listing.} Amazon Berkeley Objects (ABO) master, generated background (4:4:4, IJG quality 85, or q85; one grid square is one MCU). (a)\nobreakspace  {}Capture: region $A$ fixed, salted cells committed (dashed: the listing's certified MCUs). (b)\nobreakspace  {}Listing: opened cells on the declared generated background, outline $\mathit  {Sil}$ drawn at \mbox  {\sffamily  \upshape G3}. (c)\nobreakspace  {}Zoom (dotted box in (b)): all 2,791 certified MCUs equal libjpeg's \texttt  {islow}{} encoding of the rebuilt reference, so\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:e0}\unskip \@@italiccorr )}} passes; the background (beige) is not tested. (d,\,e)\nobreakspace  {}Illustrations, not an experiment: (d)\nobreakspace  {}a label pasted inside the outline makes 60 MCUs fail (one suffices for the court); (e)\nobreakspace  {}a new background changes no certified MCU, and the listing keeps \mbox  {\sffamily  \upshape G3}.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:cco}{{2}{5}{\textbf {A codec-cell opening on a real listing.} Amazon Berkeley Objects (ABO) master, generated background (4:4:4, IJG quality 85, or q85; one grid square is one MCU). (a)~Capture: region $A$ fixed, salted cells committed (dashed: the listing's certified MCUs). (b)~Listing: opened cells on the declared generated background, outline $\Sil $ drawn at \G {3}. (c)~Zoom (dotted box in (b)): all 2,791 certified MCUs equal libjpeg's \islow {} encoding of the rebuilt reference, so~\eqref {eq:e0} passes; the background (beige) is not tested. (d,\,e)~Illustrations, not an experiment: (d)~a label pasted inside the outline makes 60 MCUs fail (one suffices for the court); (e)~a new background changes no certified MCU, and the listing keeps \G {3}}{figure.2}{}}
\newlabel{eq:pyramid}{{2}{5}{Region and Commitment at Capture}{equation.5.2}{}}
